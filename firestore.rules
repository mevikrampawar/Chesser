rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // User-scoped saved openings
    match /users/{userId}/savedOpenings/{openingId} {
      // Only authenticated users can access
      allow read, write: if request.auth != null;

      // Users can only access their own data
      allow read: if request.auth.uid == userId;
      allow create: if request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['name', 'eco', 'moves', 'savedAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.eco is string
                    && request.resource.data.eco.size() <= 10
                    && request.resource.data.moves is list
                    && request.resource.data.moves.size() <= 100
                    && request.resource.data.savedAt is number;
      allow update: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
    }
  }
}
